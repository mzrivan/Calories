# Скопируйте в .env (или /etc/calorie-bot/calorie-bot.env) и заполните. Файл .env в .gitignore.

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Whitelist: telegram_id двух человек через запятую
ALLOWED_TELEGRAM_IDS=111111111,222222222

# --- Gemini (Google AI Studio, бесплатный уровень) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
# Должна совпадать с vector(N) в БД (задаётся при первой миграции)
EMBEDDING_DIMENSIONS=768

# --- PostgreSQL ---
DB_URL=jdbc:postgresql://localhost:5432/calories
# Приложение работает под ролью без права DELETE
DB_USER=calorie_app
DB_PASSWORD=
# Миграции Liquibase — под ролью-владельцем
DB_MIGRATION_USER=calorie_owner
DB_MIGRATION_PASSWORD=

# --- Docker compose (этап 2) ---
POSTGRES_PASSWORD=
